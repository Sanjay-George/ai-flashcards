# Backend Configuration
PORT=9051
AI_SERVICE_URL=http://localhost:9052

# Database Configuration
# Option 1: Azure DocumentDB (MongoDB API) connection string
MONGODB_URI=mongodb+srv://user:password@clustername.global.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000
# Option 2: MongoDB connection 
MONGODB_URI=mongodb://root:example@localhost:27017/flashcards-ai?authSource=admin

# Firebase Admin SDK Configuration
# Option 1: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json

# Option 2: Individual credentials (if not using JSON file)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI Service Configuration (for ai-service/.env)
# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
