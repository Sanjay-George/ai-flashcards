{
    "name": "flashcards-ai-vc",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "clean": "rimraf dist",
        "build": "tsc",
        "prestart": "npm run clean && npm run build",
        "start": "NODE_ENV=production node dist/src/index.js",
        "dev": "npm run prestart && node dist/src/index.js",
        "frontend:dev": "cd frontend && npm run dev",
        "ai:dev": "cd ai-service && uvicorn main:app --reload --port 9052"
    },
    "dependencies": {
        "chalk": "^5.6.2",
        "cors": "^2.8.6",
        "dotenv": "^17.2.4",
        "express": "^5.2.1",
        "firebase-admin": "^13.6.1",
        "mongoose": "^9.1.6",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^25.2.2",
        "rimraf": "^6.1.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    }
}